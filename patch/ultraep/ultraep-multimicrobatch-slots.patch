 csrc/ultra_ep.hpp           |  17 +++++-
 csrc/utils/ipc_manager.cuh  |   3 +-
 setup.py                    |   6 ++-
 ultra_ep/manager.py         |  39 ++++++++++----
 8 files changed, 158 insertions(+), 54 deletions(-)

